#!/bin/sh
# Pre-commit hook: run the pipeline regression self-test before every commit.
# Installed by: git config core.hooksPath .githooks  (setup-new-pc.ps1 does it)
# ASCII-only on purpose (works in Git for Windows sh and on Linux/macOS).
# If no python is available the hook prints a hint and lets the commit through,
# so a machine without Python is never blocked from committing.

# ---- Check 1: Block large files (>50MB) ----
LARGE_FILES=$(git diff --cached --name-only | while read -r f; do
    if [ -f "$f" ]; then
        SIZE=$(wc -c < "$f" 2>/dev/null || echo 0)
        if [ "$SIZE" -gt 52428800 ]; then
            echo "  $f ($(($SIZE / 1048576)) MB)"
        fi
    fi
done)

if [ -n "$LARGE_FILES" ]; then
    echo "[pre-commit] BLOCKED: Large files detected (>50MB):"
    echo "$LARGE_FILES"
    echo "[pre-commit] Use Git LFS or remove these files from the commit."
    exit 1
fi

# ---- Check 2: Block sensitive patterns ----
SENSITIVE=$(git diff --cached --name-only | while read -r f; do
    if [ -f "$f" ] && echo "$f" | grep -qiE '\.(dumate|_work)/'; then
        echo "  $f"
    fi
done)

if [ -n "$SENSITIVE" ]; then
    echo "[pre-commit] BLOCKED: Sensitive/temporary paths detected:"
    echo "$SENSITIVE"
    echo "[pre-commit] These paths are excluded by .gitignore but were force-added."
    exit 1
fi

# ---- Check 3: Run selftest ----
PY=""
if command -v python >/dev/null 2>&1; then
    PY="python"
elif command -v python3 >/dev/null 2>&1; then
    PY="python3"
fi

if [ -z "$PY" ]; then
    echo "[pre-commit] python not found - skipped qa/selftest.py (commit allowed)."
    exit 0
fi

echo "[pre-commit] running $PY qa/selftest.py --quiet ..."
if "$PY" qa/selftest.py --quiet; then
    exit 0
fi

echo ""
echo "[pre-commit] selftest FAILED - commit blocked."
echo "[pre-commit] Fix the pipeline, or run 'python qa/selftest.py' for details."
exit 1
