      "promo_terms": [
        "descuento", "cupón", "cupom", "rebaja", "oferta", "promoción", "promoção",
        "2x1", "precio especial", "preço especial"
      ],
      "param_units": "\\d+(?:[.,]\\d+)?\\s?(mm|cm|V|W|Nm|kg|L|ml|rpm)\\b"
    }
  },
  "compliance": {
    "note": "合规来源清单与台账指针。规则只在 certifications.json，本段只放出处，避免两处改规则。",
