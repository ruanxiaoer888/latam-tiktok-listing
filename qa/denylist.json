  "categories": {
    "五金工具": {
      "note": "手动工具只看 尺寸+材质；电动类（出现 inalámbrico/batería/eléctrico/motor/cargador）才追加电压与功率，靠 if_pattern 自动判断",
      "required": [
        { "label": "规格尺寸(mm/cm)", "pattern": "\\d+\\s?(mm|cm)\\b" },
        { "label": "材质", "pattern": "(acero|aço|cromo|vanadio|aluminio|alumínio|cobre|metal|metálic|lithium|litio)" },
        {
          "label": "电压或电池平台（电动类才需要）",
          "pattern": "\\d+\\s?V\\b",
          "if_pattern": "(inal[aá]mbric|bater[ií]a|el[eé]ctric|motor|cargador|enchufe)"
        },
        {
          "label": "功率/扭矩/转速（电动类才需要）",
          "pattern": "\\d+\\s?(W|Nm|rpm)\\b",
          "if_pattern": "(inal[aá]mbric|bater[ií]a|el[eé]ctric|motor|cargador|enchufe)"
        }
      ]
    },
    "汽车摩托": {
      "note": "只有明确适配某车型的配件才查年款/位置；通用工具（千斤顶、拖车绳等）不查，靠 if_pattern 判断",
      "required": [
        {
          "label": "适配年款",
          "pattern": "(19|20)\\d{2}",
          "if_pattern": "(compatible con|compatível com|nissan|toyota|honda|chevrolet|volkswagen|ford|mazda|kia|hyundai|suzuki|yamaha|italika|bajaj)"
