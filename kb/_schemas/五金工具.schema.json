{
  "schema": "category-schema/v1",
  "category": "五金工具",
  "version": "1.1",
  "updated": "2026-10-21",
  "description": "五金工具事实卡字段。required = 生成硬门槛；recommended = 缺了提醒但不阻断。",
  "required": [
    { "path": "identity.brand", "label": "品牌" },
    { "path": "power.type", "label": "供电类型（corded/battery/manual）" },
    { "path": "package.included", "label": "包装清单", "non_empty": true }
  ],
  "recommended": [
    { "any_of": ["size.length_cm", "size.width_cm", "size.height_cm", "size.raw"], "label": "尺寸" },
    { "path": "material", "label": "材质", "non_empty": true },
    { "path": "weight_kg", "label": "整机重量" },
    { "path": "power.w", "label": "可写功率（若 state_power=true）" }
  ],
  "power_rules": {
    "corded_max_w": 3500,
    "battery_max_w": 600,
    "note": "插电类 >=3500W 在 127V 下超过 27A，家用回路不成立；电池类 >=600W 多为等效/峰值，不得当持续功率写。",
    "voltage_required": {
      "corded": "power.voltage_v",
      "battery": "power.battery_v"
    }
  },
  "notes": [
    "电池工具必须区分电池电压与充电器输入电压。",
    "包装清单是硬门槛：没有清单就不生成（退货风险最高）。",
    "缺必带信息 → 不准生成，先补资料或标 blocked。"
  ]
}
